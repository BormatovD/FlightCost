{
 "title": "flightcost.app — сеть и отчёт по парку (десктоп)",
 "device": "desktop",
 "viewport": [1440, 810],
 "path": "/?lang=ru&cur=USD",
 "locale": "ru-RU",
 "intro": {"title": ["Сколько рынка нужно забрать?"], "sub": "Сеть и отчёт по парку на flightcost.app"},
 "outro": {"title": ["Какой тип брать — и при каком объёме."], "url": "flightcost.app", "sub": "открытый код · бесплатно · в браузере"},
 "steps": [
  {"do": "wait", "ms": 900},

  {"do": "caption", "n": 1, "text": "Режим «Сеть»", "sub": "авиакомпания из N бортов одного типа"},
  {"do": "tap", "sel": "#mode button[data-mode=net]", "after": 1500},

  {"do": "caption", "n": 2, "text": "Соберите аэропорты", "sub": "код, название или щелчок по глобусу"},
  {"do": "tap", "sel": "#nadd"}, {"do": "clear", "sel": "#nadd"},
  {"do": "type", "sel": "#nadd", "text": "DME", "delay": 120},
  {"do": "tap", "sel": "#naddh .hit[data-key]", "after": 450},
  {"do": "tap", "sel": "#nadd"}, {"do": "clear", "sel": "#nadd"},
  {"do": "type", "sel": "#nadd", "text": "OVB", "delay": 120},
  {"do": "tap", "sel": "#naddh .hit[data-key]", "after": 450},
  {"do": "tap", "sel": "#nadd"}, {"do": "clear", "sel": "#nadd"},
  {"do": "type", "sel": "#nadd", "text": "ALA", "delay": 120},
  {"do": "tap", "sel": "#naddh .hit[data-key]", "after": 450},
  {"do": "tap", "sel": "#nadd"}, {"do": "clear", "sel": "#nadd"},
  {"do": "type", "sel": "#nadd", "text": "DEL", "delay": 120},
  {"do": "tap", "sel": "#naddh .hit[data-key]", "after": 900},

  {"do": "caption", "n": 3, "text": "Выберите базу", "sub": "права на линии — от страны базы"},
  {"do": "tap", "sel": "#nchips .chip[data-k=ALA]", "after": 1400},

  {"do": "caption", "n": 4, "text": "Задайте парк", "sub": "сколько бортов летает по сети"},
  {"do": "fill", "sel": "#nfleet", "text": "6", "after": 1200},

  {"do": "caption", "n": 5, "text": "Считайте сеть", "sub": "права, дальность и закрытое небо отсекаются сами"},
  {"do": "tap", "sel": "#ngo", "after": 500},
  {"do": "waitfor", "js": "!/считаю|расчёт идёт/i.test(document.querySelector('#main').innerText.slice(0,200)) && /пара|Не посчитать/.test(document.querySelector('#main').innerText)", "speed": 6, "timeout": 600000, "after": 900},
  {"do": "zoom", "box": [1000, 115, 440, 695], "ms": 6000, "scale": 1.16, "wait": false},
  {"do": "wait", "ms": 2400},
  {"do": "scrollby", "in": "#main", "dy": 460, "ms": 1800},
  {"do": "wait", "ms": 1500},

  {"do": "caption", "n": 6, "text": "Сравните типы", "sub": "та же сеть на каждом типе"},
  {"do": "tap", "sel": "#tabs button[data-tab=ntypes]", "after": 900},
  {"do": "tap", "sel": "#main button.chipb[data-add=A20N]", "after": 600},
  {"do": "tap", "sel": "#main button.chipb[data-add=B38M]", "after": 600},
  {"do": "tap", "sel": "#ncmpgo", "after": 400},
  {"do": "waitfor", "js": "!!document.querySelector('#main a[href^=\"/report\"]') || /Не посчитать/.test(document.querySelector('#main').innerText)", "speed": 8, "timeout": 1200000, "after": 500},
  {"do": "zoom", "box": [1000, 115, 440, 695], "ms": 3200, "scale": 1.16},

  {"do": "caption", "n": 7, "text": "Откройте отчёт по парку", "sub": "вывод, характеристики, экономика кресла"},
  {"do": "tap", "sel": "#main a[href^=\"/report\"]", "nav": true, "after": 300},
  {"do": "waitfor", "js": "location.pathname==='/report' && !!document.querySelector('h1') && !/пар посчитано|Считаю/.test(document.body.innerText)", "speed": 8, "timeout": 1200000, "after": 500},
  {"do": "wait", "ms": 2600},
  {"do": "scroll", "sel": "h2", "nth": 1, "offset": 110, "ms": 1600},
  {"do": "wait", "ms": 1600},
  {"do": "scroll", "sel": "h2", "nth": 2, "offset": 110, "ms": 1600},
  {"do": "wait", "ms": 1600},
  {"do": "scroll", "sel": "h2", "nth": 3, "offset": 110, "ms": 1600},
  {"do": "wait", "ms": 1800},

  {"do": "caption", "n": 8, "text": "Меняйте долю рынка", "sub": "отчёт пересчитается под ваш объём"},
  {"do": "fill", "sel": "input[name=share]", "text": "20", "after": 500},
  {"do": "tap", "sel": "button.go", "nav": true, "after": 300},
  {"do": "waitfor", "js": "location.pathname==='/report' && !!document.querySelector('h1') && !/пар посчитано|Считаю/.test(document.body.innerText)", "speed": 8, "timeout": 1200000, "after": 400},
  {"do": "zoom", "sel": "h1", "ms": 2800, "scale": 1.6},

  {"do": "caption", "n": 9, "text": "Плюсы и минусы на этой сети", "sub": "у каждого типа — в цифрах вашей сети"},
  {"do": "scroll", "sel": "h2", "nth": 5, "offset": 110, "ms": 1800},
  {"do": "wait", "ms": 2400},

  {"do": "caption", "n": 10, "text": "PDF и Excel", "sub": "документ для пересылки и расчёт с живыми формулами"},
  {"do": "scrollby", "dy": -100000, "ms": 1400},
  {"do": "zoom", "box": [800, 0, 400, 90], "ms": 2800, "scale": 2.4},
  {"do": "wait", "ms": 400}
 ],
 "tail_ms": 500
}
