  },
  {
   "label": "Безубыточный чек",
   "js": "document.querySelector('#kpi > div:nth-child(2)').innerText.split('\\n')[1].replace(/(\\d)([A-Z]{3})/,'$1 $2')"
  },
  {
   "label": "Итог с пассажира",
   "kind": "signed",
   "js": "(t=>{const m=t.match(/(не хватает|запас)\\s+([\\d\\s\\u00a0\\u202f.,]+?)\\s*([A-Z]{3})/);return m?(m[1]==='запас'?'+':'−')+m[2].trim()+' '+m[3]:''})(document.querySelector('#kpi > div:nth-child(2)').innerText)"
  }
 ],
