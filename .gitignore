# ── окружение ────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.egg-info/
.DS_Store

# ── данные: в репозитории рецепты, а не снимки (решение 1) ──────────────
# Хранилище — производная от источников, собирается `fca refresh`.
data/flightcost.db
data/flightcost.db-*
# Скачанные артефакты и сырые выгрузки — чужие данные и чужие лицензии.
data/raw/
data/artifacts/
# Геометрия зон и суши — кэш рецепта.
data/geo/
# Указатель кодов IP2Location: CC BY-SA, перелицензировать нельзя (NOTICE).
# Каталог закрыт по содержимому, а не целиком: иначе git не даст открыть в
# нём ваш собственный перечень аэропортов.
data/codes/*
!data/codes/airports_list.xlsx
# Таблица соответствия кодов сообщества → ИКАО — своя расшифровка, нужна парсеру
# выгрузки сообщества; без неё чистая копия не опознаёт ни одного аэропорта.
!data/codes/tkp_codes.yaml
# Сырая выгрузка сообщества — подписной продукт целиком; в репозиторий идёт только
# её упаковка `fca tkp-pack` (data/tkp/tkp_charges.json).
data/tkp/*.xlsx
# Свои типы ВС владельца — его сценарий, а не справочник (решение 148).
data/aircraft/user/
# Архив и отложенное из каталога тарифов.
data/charges/_old/
data/charges/_pending/
*.bak

# ── сбор цен ─────────────────────────────────────────────────────────────
flight_data/
routes.xlsx

# ── порождаемое ──────────────────────────────────────────────────────────
# Разборы и витрина данных пересобираются командой; в репозитории только
# пример, добавленный явно.
docs/*.html
!docs/example-*.html

# ── ключи ────────────────────────────────────────────────────────────────
.env
*.env
secrets/

# IDE и логи
.idea/
logs/

# IDE и логи
.idea/
logs/
data/user.db
