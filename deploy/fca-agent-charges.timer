# Тариф одного аэропорта из data/charges/_todo.yaml дважды в неделю (решение
# владельца 06.11.2026): по два аэропорта с документом на каждый из регионов
# списка — около сорока тарифов. Явный список — FCA_AGENT_CHARGES_ONLY в
# /etc/fca/agent.env.
[Unit]
Description=FlightCostApp — агент: тариф аэропорта

[Timer]
OnCalendar=Mon,Thu *-*-* 07:40:00 UTC
Persistent=true
Unit=fca-agent@charges.service

[Install]
WantedBy=timers.target
