[Unit]
Description=FlightCost private Telegram Mini App
After=network.target
ConditionPathExists=/etc/fca/bot.token

[Service]
User=fcabot
EnvironmentFile=/etc/fca/bot.env
LoadCredential=bot-token:/etc/fca/bot.token
ExecStart=/srv/fca/venv/bin/python -m flightcostapp.admin_app
Restart=on-failure
RestartSec=10s
CPUQuota=10%
MemoryMax=64M
TasksMax=12
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/srv/fca/agent/queue/airport-admin
ReadWritePaths=-/var/spool/fca-fare-observer/ticket-admin
InaccessiblePaths=-/srv/fca/master -/srv/fca/site -/srv/fca/observe -/srv/fca/backup -/srv/fca/bot
InaccessiblePaths=-/srv/fca/agent/runs -/srv/fca/agent/home -/var/lib/fca-fo-tickets -/var/lib/fca-fo-ingest

[Install]
WantedBy=multi-user.target
