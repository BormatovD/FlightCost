# Обратный прокси перед витриной. bootstrap.sh кладёт его в /etc/caddy/Caddyfile,
# подставив домен вместо ДОМЕН. Пока домена нет — http://<адрес сервера>,
# витрина по адресу без HTTPS (только чтобы проверить до смены DNS).
#
# С доменом Caddy сам получает сертификат Let's Encrypt и продлевает его.

ДОМЕН {
	encode zstd gzip
	# Перезапуск витрины (deploy.sh, bootstrap.sh) — 2–6 секунд, пока процесс не
	# откроет порт. Раньше Caddy в это окно сразу отдавал 502 (09.11.2026: шесть
	# выкладок — шесть окон 502, в них попали поисковый робот и владелец). Теперь
	# запрос ждёт подъёма до 15 секунд и уходит, как только порт открыт.
	reverse_proxy 127.0.0.1:8000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	request_body {
		max_size 1MB
	}

	# Журнал — то, что обещает /datenschutz, пункт 4: адрес усечён до
	# сети (/24, /48) ещё до записи, заголовки (браузер, referrer) не
	# пишутся вовсе, ротированные файлы живут 7 дней. Меняете здесь —
	# меняйте текст политики.
	log {
		output file /var/log/caddy/fca.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 7d
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers delete
				resp_headers delete
			}
		}
	}
}
